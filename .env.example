# TaaSim environment file — copy to `.env` (which is gitignored) and fill in real values.
# The Spring services read these via ${VAR:default} placeholders in each application.yml,
# so you can also override them per-shell or per-service at runtime.

# ---- Service ports (usually you don't change these) ----
AUTH_SERVER_PORT=8081
DRIVER_SERVER_PORT=8083
TRIP_SERVER_PORT=8082
MATCHING_SERVER_PORT=8085

# ---- Infrastructure hosts ----
# When services run on your Windows host (java -jar ...): use localhost + external port
# When services run inside Docker (docker-compose.backend.yml): compose overrides these
CASSANDRA_HOST=localhost
CASSANDRA_PORT=9042
CASSANDRA_KEYSPACE=taasim
CASSANDRA_DC=datacenter1

KAFKA_BOOTSTRAP=localhost:9092

# ---- Kafka consumer groups (rename to reset offsets during dev) ----
KAFKA_CONSUMER_GROUP_MATCHING=matching-service-v2

# ---- Logging ----
LOG_LEVEL_KAFKA=INFO
LOG_LEVEL_CONSUMER=INFO

# ---- Actuator surface ----
MANAGEMENT_ENDPOINTS=health,info,metrics
ACTUATOR_ENDPOINTS=health,info

# ---- PostgreSQL (Slice 9 / 10 / 10.5 auth-service) ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=taasim
POSTGRES_USER=taasim
POSTGRES_PASSWORD=taasim

# ---- JWT Token Configuration (Slice 10 / 10.5) ----
# 256-bit random string; generate with:
#   [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }))
JWT_SECRET=change-me-to-a-real-256-bit-random-string
JWT_EXPIRATION_MS=86400000

# ---- Placeholders for later slices — leave empty or comment out until then ----
# Slice 13 (Redis)
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=

# Slice 16 (Stripe)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
